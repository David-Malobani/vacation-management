{
  "name": "vacation-management-server",
  "version": "1.0.0",
  "private": true,
  "description": "Vacation management API (Node.js + CommonEventFramework + TypeORM + PostgreSQL)",
  "type": "commonjs",
  "scripts": {
    "dev": "npm run codegen && node --watch -r ts-node/register/transpile-only src/server.ts",
    "codegen": "node node_modules/commoneventframework/dist/script/generateHandlerRegistry.js",
    "build": "npm run codegen && node node_modules/commoneventframework/dist/script/build.js --skip-codegen",
    "start": "npm run codegen && ts-node --transpile-only src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "db:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "db:seed": "ts-node --transpile-only src/database/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "commoneventframework": "^1.0.19",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
